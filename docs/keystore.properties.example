# Пример конфигурации подписи Release APK
# Скопируйте этот файл в корень проекта как `keystore.properties`
# и укажите параметры вашего production ключа.
# Файл keystore.properties добавлен в .gitignore и не попадет в репозиторий.

storeFile=release.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password

