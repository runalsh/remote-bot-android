# ==============================================================================
# RemoteBot Server Gateways Environment Configuration
# ==============================================================================

# Активный профиль Docker Compose: go | python | nginx | npx
COMPOSE_PROFILES=go

# Push Gateway Service Configuration
PUSH_GATEWAY_PORT=8080
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
WHITELIST_CHAT_IDS=12345678,87654321
PUSH_PROVIDER=auto

# FCM v1 (Google Service Account JSON as single line or string)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# FCM Legacy Server Key (optional fallback)
FCM_LEGACY_SERVER_KEY=

# Huawei Push Kit (HMS) Credentials
HUAWEI_APP_ID=
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# API Proxy Configuration (Telegram Reverse Proxy)
API_PROXY_PORT=8081
TARGET_HOST=api.telegram.org

